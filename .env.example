#chave da KEY da OpenAI
OPENAI_API_KEY=

#modelo da OpenAI usado na correção (obrigatório), ex.: gpt-4o-mini
AI_MODEL=

#chave secreta de autenticação do Flask
SECRET_KEY=

#direcionamento do banco de dados (no Render, use a URL do PostgreSQL)
DATABASE_URL=

#"production" no Render (ativa cookies seguros e o ProxyFix)
APP_ENV=
